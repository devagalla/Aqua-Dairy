# Supabase Project Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key-here" # Found on your project's API settings page

# Server-side only - used for admin tasks (never expose to client)
SUPABASE_SECRET_KEY="your-secret-key-here" # Found on your project's API settings page (replaces service_role key)
# For legacy support, also supports: SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Application settings
NEXT_PUBLIC_SITE_URL=https://www.aquadairy.xyz

# Browser key: restrict by allowed website referrers and the Maps JavaScript API + Places API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-restricted-browser-key

# Cloudflare Turnstile public site key (the secret key belongs only in Supabase Auth settings)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Allow these paths in Supabase Auth > URL Configuration > Redirect URLs:
# https://www.aquadairy.xyz/auth/callback
# https://aqua-dairy.vercel.app/auth/callback
# http://localhost:3000/auth/callback
